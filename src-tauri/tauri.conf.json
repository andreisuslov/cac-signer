{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAC Signer",
  "version": "0.1.0",
  "identifier": "com.andreisuslov.cac-signer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CAC Signer",
        "width": 1120,
        "height": 800,
        "minWidth": 780,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
